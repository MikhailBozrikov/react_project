{
  "name": "marusya-cinema",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "npx kill-port 3000 3002 8080",
    "dev": "next dev --port 3000 --hostname localhost",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "if (Test-Path .next) { Remove-Item -Recurse -Force .next }",
    "clean:all": "if (Test-Path node_modules) { Remove-Item -Recurse -Force node_modules }; if (Test-Path package-lock.json) { Remove-Item -Force package-lock.json }; if (Test-Path .next) { Remove-Item -Recurse -Force .next }",
    "reinstall": "npm run clean:all && npm cache clean --force && npm install"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.7",
    "axios": "^1.13.5",
    "lucide-react": "^0.309.0",
    "next": "^16.1.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^8.1.3",
    "redux": "^4.2.1",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/react-redux": "^7.1.33",
    "@types/redux-persist": "^4.0.0",
    "kill-port": "^2.0.1",
    "typescript": "^5.3.3"
  }
}